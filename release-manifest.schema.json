{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMID Offgrid artifact provenance",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "version",
    "build",
    "platform",
    "sourceCommit",
    "githubRunUrl",
    "quality",
    "deviceTesting",
    "storeSubmission",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "AMID Offgrid"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build": {
      "type": "integer",
      "minimum": 1
    },
    "platform": {
      "enum": [
        "android",
        "ios",
        "windows",
        "linux",
        "macos",
        "wearos",
        "watchos",
        "web"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "githubRunUrl": {
      "type": "string"
    },
    "quality": {
      "enum": [
        "success",
        "not_recorded"
      ]
    },
    "deviceTesting": {
      "const": "not_run"
    },
    "storeSubmission": {
      "const": "not_run"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "bytes",
          "sha256",
          "kind",
          "signing",
          "physicalDeviceTested"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "apk",
              "aab",
              "ipa",
              "zip"
            ]
          },
          "signing": {
            "enum": [
              "development",
              "distribution",
              "unsigned"
            ]
          },
          "physicalDeviceTested": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
